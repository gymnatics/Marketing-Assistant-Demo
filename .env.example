# Vertical Configuration (hotel-casino, retail-mall, banking, telco)
VERTICAL_CONFIG=hotel-casino

# Code Model (L40S #1) - Creative Producer
CODE_MODEL_ENDPOINT=https://qwen25-coder-32b-fp8-<namespace>.apps.<cluster-domain>/v1
CODE_MODEL_NAME=qwen25-coder-32b-fp8
CODE_MODEL_TOKEN=

# Language Model (L40S #2) - Customer Analyst, Delivery Manager, Policy Guardian
LANG_MODEL_ENDPOINT=https://qwen3-32b-fp8-dynamic-<namespace>.apps.<cluster-domain>/v1
LANG_MODEL_NAME=qwen3-32b-fp8-dynamic
LANG_MODEL_TOKEN=

# Image Generation Model (L40S #3) - ImageGen MCP
IMAGEGEN_MODEL_ENDPOINT=https://flux2-klein-4b-<namespace>.apps.<cluster-domain>/v1
IMAGEGEN_MODEL_NAME=flux2-klein-4b
IMAGEGEN_MODEL_TOKEN=
IMAGEGEN_MCP_SELF_URL=http://imagegen-mcp:8091

# OpenShift
CLUSTER_DOMAIN=apps.<cluster-domain>
DEV_NAMESPACE=0-marketing-assistant-demo-dev
PROD_NAMESPACE=0-marketing-assistant-demo-prod

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=casino_crm

# MLflow (optional - leave empty to disable tracing)
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=marketing-assistant
